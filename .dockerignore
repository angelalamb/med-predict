__pycache__/
*.pyc
*.pyo
*.pyd
*.egg
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Test artefacts
.pytest_cache/
.coverage
htmlcov/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker compose overrides
*.override.yml

# Docs
README.md
